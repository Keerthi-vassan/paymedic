# Which LLM backs ambiguous-case classification: anthropic | openai | gemini | sarvam
LLM_PROVIDER=anthropic

# Only the key for the selected provider is required; the others can stay blank.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...
SARVAM_API_KEY=...

# Optional real Razorpay test-mode integration -- blends a small number of
# real API-driven transactions into the batch instead of every outcome being
# a simulated hash-roll. If unset/false, the system is 100% simulated, exactly
# as before (the safe default -- no keys needed for a clean clone to run).
RAZORPAY_EXECUTION_ENABLED=false
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_REAL_TXN_COUNT=4

# Optional real webhook ingestion. Set this to the signing secret Razorpay
# shows when you create a webhook, then point that webhook at
# POST /webhooks/razorpay with the payment.failed event enabled. Every
# delivery is HMAC-SHA256 verified against the raw request body. Left blank,
# the endpoint refuses all deliveries rather than accepting unverified ones,
# and nothing else changes.
RAZORPAY_WEBHOOK_SECRET=

# Customer-facing reminder copy. The built-in template is always used as the
# fallback; with this on, the configured LLM rewrites the template once per
# batch and the result must pass a content guard (placeholder intact, no
# digits, no links, within length) before it is used.
NOTIFICATION_LLM_ENABLED=true

# Hard bound on a single classification call. A rate-limited provider would
# otherwise turn a ~10s batch into minutes of invisible SDK backoff.
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1
